from building import *
import os

cwd = GetCurrentDir()
books = os.path.abspath(os.path.join(cwd, '..', '..', 'books'))
formats = os.path.join(books, 'formats')
env = GetCurrentEnv().Clone()
env.Append(CPPPATH=[cwd, os.path.join(cwd, 'compute/include'),
                   os.path.abspath(os.path.join(cwd, '../../../src/platform')),
                   os.path.abspath(os.path.join(cwd, '../../../components/compute/include')),
                   os.path.abspath(os.path.join(cwd, '../../../components/compute_reader_render/include')),
                   os.path.abspath(os.path.join(cwd, '../../../components/compute_reading_data/include'))],
           CPPDEFINES=['BUILD_DLMODULE', 'BOOK_FORMAT_TARGET'],
           CCFLAGS=' -O2 -ffunction-sections -fdata-sections')
sources = [os.path.join(cwd, name) for name in
           ('reader_view.c', 'reader_note_ui.c', 'reader_page_cache.c', 'reader_font.c', 'reader_source.c',
            'compute/reader_page.c', 'compute/reader_wire.c', 'compute/reader_client.c')]
sources += [os.path.join(books, 'document', name) for name in
            ('document.c', 'document_cache.c')]
sources += [os.path.join(formats, 'formats_info.c')]
objects = []
for source in sources:
    target = os.path.basename(source).replace('.c', '.o')
    objects += env.Object(target, source)
Return('objects')
