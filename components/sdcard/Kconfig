menuconfig PKG_USING_EPD_SDCARD
    bool "SD card media lifecycle service"
    depends on RT_USING_PIN && RT_USING_SDIO && BSP_USING_SD_LINE
    depends on RT_USING_DFS && RT_USING_DFS_ELMFAT
    depends on (BSP_USING_SDMMC1 && SDIO_CARD_MODE = 0) || (BSP_USING_SDMMC2 && SDIO2_CARD_MODE = 0)
    depends on SD_INSERT_DETECT_PIN = -1
    default n
    help
        Manage SD card detection and DFS FAT mount/unmount from a worker.
        The platform supplies the card configuration and acknowledges release
        of media users before unmounting. The SDK probes at startup without
        a card-detect GPIO; this component owns the GPIO and hotplug handling.
        GNU linker mailbox wrappers track the native detector's completion.

if PKG_USING_EPD_SDCARD
config EPD_SDCARD_DETECT_PIN
    int "SD card detection GPIO"
    range 0 255
    default 51
endif

