from pathlib import Path
from building import *
from compute_build import load_product_components

cwd = Path(GetCurrentDir())
root = cwd.parents[1]
env = GetCurrentEnv()
profile_path = root / 'project' / (GetBoardName('HCPU') or '') / 'compute.json'
registry = load_product_components(root, ARGUMENTS.get('COMPUTE_COMPONENTS'), profile_path)

output = Path(env['BUILD_DIR_FULL_PATH'])
targets = registry.scons_generate(env, output)
env['EPD_COMPUTE_REGISTRY'] = registry
env['EPD_COMPUTE_TARGETS'] = targets
sources = Glob('epd_compute_protocol.c') + Glob('epd_compute_cache.c') + Glob('epd_compute_pipe_host.c') + [targets[0]]
objects = DefineGroup('epd_compute_common', sources, depend=[], CPPPATH=[str(cwd / 'include')])
Return('objects')
