from building import *
from SCons.Script import VariantDir
import os

objects = list(DefineGroup('reader_contracts', Glob('*.c'), depend=['EPD_USE_LVGL'],
                          CPPPATH=[GetCurrentDir()], LOCAL_CCFLAGS='-Wall -Wextra -Werror'))
compute = os.path.abspath(os.path.join(GetCurrentDir(), '../../../modules/common/reader/compute'))
VariantDir('compute', compute, duplicate=0)
objects += DefineGroup('reader_compute_service',
                       ['compute/reader_client.c', 'compute/reader_kernel.c'],
                       depend=['EPD_USE_LVGL'], LOCAL_CPPPATH=[os.path.join(compute, 'include')],
                       LOCAL_CCFLAGS=' -O2')
font = os.path.abspath(os.path.join(compute, '../reader_font.c'))
objects += DefineGroup('reader_fonts', [font], depend=['EPD_USE_LVGL'])
Return('objects')
