Import('RTT_ROOT')
Import('rtconfig')
from building import *
import os

cwd = GetCurrentDir()
src = Glob('*.c')
CPPPATH = [cwd]

if GetDepend('USING_BATTERY_CALCULATOR'):
    Import('SIFLI_SDK')
    # Reuse the SDK reference curves without copying or rescaling their points.
    VariantDir('sdk_battery_curve',
               os.path.join(SIFLI_SDK, 'customer', 'boards', 'sf32lb52-nano_base'),
               duplicate=0)
    src += [os.path.join('sdk_battery_curve', 'battery_table.c')]

group = DefineGroup('battery', src, depend = [''], CPPPATH = CPPPATH)

Return('group')
